{
  "$comment": [
    "Applied over the Code - OSS product.json before gulp runs, by",
    "scripts/build-vscode-oss.sh. Doing it at build time rather than patching the",
    "packaged tree afterwards means the values are baked in wherever the build",
    "inlines them, not just where a later regex happened to reach.",
    "",
    "assets/server.js rewrites product.json again at every start. That override",
    "stays, because it is the only place the port-dependent values can be filled",
    "in, but it merges shallowly — a nested object it names replaces the built one",
    "wholesale. Keep extensionsGallery identical in both."
  ],

  "remove": [
    "webviewContentExternalBaseUrlTemplate",

    "darwinBundleIdentifier",
    "linuxIconName",
    "tunnelApplicationName",
    "nodejsRepository",

    "win32AppUserModelId",
    "win32DirName",
    "win32MutexName",
    "win32NameVersion",
    "win32RegValueName",
    "win32ShellNameShort",
    "win32TunnelMutex",
    "win32TunnelServiceMutex",
    "win32arm64AppId",
    "win32arm64UserAppId",
    "win32x64AppId",
    "win32x64UserAppId"
  ],

  "set": {
    "nameShort": "VSCodroid",
    "nameLong": "VSCodroid",
    "applicationName": "vscodroid",
    "dataFolderName": ".vscodroid",
    "serverApplicationName": "vscodroid-server",
    "serverDataFolderName": ".vscodroid-server",
    "urlProtocol": "vscodroid",
    "quality": "stable",

    "extensionsGallery": {
      "serviceUrl": "https://open-vsx.org/vscode/gallery",
      "itemUrl": "https://open-vsx.org/vscode/item",
      "resourceUrlTemplate": "https://open-vsx.org/vscode/unpkg/{publisher}/{name}/{version}/{path}",
      "controlUrl": "",
      "nlsBaseUrl": ""
    },
    "linkProtectionTrustedDomains": ["https://open-vsx.org"],

    "telemetryOptIn": false,
    "enableTelemetry": false,

    "reportIssueUrl": "https://github.com/rmyndharis/VSCodroid/issues/new",
    "licenseUrl": "https://github.com/rmyndharis/VSCodroid/blob/main/LICENSE",
    "serverLicenseUrl": "https://github.com/rmyndharis/VSCodroid/blob/main/LICENSE"
  }
}

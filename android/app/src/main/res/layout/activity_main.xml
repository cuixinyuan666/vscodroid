<?xml version="1.0" encoding="utf-8"?>
<!--
    Vertical, not a FrameLayout: the key row has to take height away from the
    WebView rather than sit on top of it. Stacked, it covered the bottom 210px
    of the page, which is exactly where VS Code anchors the chat toolbar, so the
    model picker and Send button could be seen but never tapped.

    Portrait full-screen paging is driven by the low-opacity chevrons on the
    WebView host, not by horizontal swipes in the workbench.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webViewContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/webViewHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- VS Code Web UI rendered in WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/pagerNavLeft"
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_gravity="center_vertical|start"
            android:alpha="0.28"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pager_nav_previous"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pager_chevron_left"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/pagerNavRight"
            android:layout_width="48dp"
            android:layout_height="72dp"
            android:layout_gravity="center_vertical|end"
            android:alpha="0.28"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pager_nav_next"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pager_chevron_right"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Extra key row: Tab, Esc, Ctrl, Alt, arrows, brackets, etc. -->
    <com.vscodroid.keyboard.ExtraKeyRow
        android:id="@+id/extraKeyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>

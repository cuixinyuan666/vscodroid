{
    "name": "vscodroid-github-auth",
    "displayName": "VSCodroid GitHub Authentication",
    "description": "GitHub OAuth integration for VSCodroid — routes authentication through Android Custom Tabs",
    "version": "1.0.0",
    "publisher": "vscodroid",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onAuthenticationRequest:github"
    ],
    "main": "./extension.js",
    "contributes": {
        "authentication": [
            {
                "id": "github",
                "label": "GitHub"
            }
        ]
    }
}

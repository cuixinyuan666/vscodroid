{
  "name": "vscodroid-terminal-autoclose",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "vscodroid",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "VSCodroid Terminal Auto Close",
      "properties": {
        "vscodroid.terminalAutoClose.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.enabled%"
        },
        "vscodroid.terminalAutoClose.delaySeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 600,
          "description": "%config.delaySeconds%"
        }
      }
    }
  }
}
{
  "name": "vscodroid-kai",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "vscodroid",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:vscodroid.kai.panel",
    "onCommand:vscodroid.kai.open",
    "onCommand:vscodroid.kai.startSingle",
    "onCommand:vscodroid.kai.startWar",
    "onCommand:vscodroid.kai.importApiKeys",
    "onCommand:vscodroid.kai.openInEditor",
    "onCommand:vscodroid.kai.openFullscreen",
    "onCommand:vscodroid.kai.openInSidebar"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "VSCodroid Kai",
      "properties": {
        "vscodroid.kai.autoStartOpenCode": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStartOpenCode%"
        },
        "vscodroid.kai.zenModel": {
          "type": "string",
          "default": "big-pickle",
          "enum": [
            "big-pickle",
            "ling-3.0-flash-fin-free",
            "mimo-v2.5-free",
            "muse-spark-1.2-contributor-free",
            "muse-spark-1.3-contributor-free",
            "nemotron-3-ultra-free",
            "nemotron-3.5-lightning-free",
            "deepseek-v4-flash-free",
            "laguna-s-2.1-free"
          ],
          "description": "%config.zenModel%"
        },
        "vscodroid.kai.freeLlmApiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3001/v1",
          "description": "%config.freeLlmApiBaseUrl%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscodroid-kai",
          "title": "%viewContainer.title%",
          "icon": "media/kai.svg"
        }
      ]
    },
    "views": {
      "vscodroid-kai": [
        {
          "type": "webview",
          "id": "vscodroid.kai.panel",
          "name": "%view.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "vscodroid.kai.open",
        "title": "%command.open%"
      },
      {
        "command": "vscodroid.kai.startSingle",
        "title": "%command.startSingle%"
      },
      {
        "command": "vscodroid.kai.startWar",
        "title": "%command.startWar%"
      },
      {
        "command": "vscodroid.kai.importApiKeys",
        "title": "%command.importApiKeys%"
      },
      {
        "command": "vscodroid.kai.openInEditor",
        "title": "%command.openInEditor%"
      },
      {
        "command": "vscodroid.kai.openFullscreen",
        "title": "%command.openFullscreen%"
      },
      {
        "command": "vscodroid.kai.openInSidebar",
        "title": "%command.openInSidebar%"
      }
    ]
  }
}
